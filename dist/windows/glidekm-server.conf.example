# glidekm server configuration - keep next to glidekm-server.exe

# Steam Deck address (IP or hostname, optional :port). Leave empty to find
# the Deck automatically on the local network.
client =
# Optional. Leave unset to pair with any glidekm on the network; if set, use
# the same passphrase on the PC and the Deck.
# passphrase = my-secret

# Where the Deck "monitor" sits relative to your Windows desktop:
# right | left | top | bottom
side = right
# Shift the Deck screen along that edge (Windows pixels). E.g. 280 means the
# Deck's top edge lines up 280 px below the top of your desktop.
offset = 0
# Windows pixels per Deck pixel. >1 makes the cursor move slower on the Deck.
scale = 1.0

# Hotkeys (modifiers: ctrl alt shift win)
hotkey_switch = ctrl+alt+shift+s
hotkey_capture = ctrl+alt+shift+m

# log_file = glidekm-server.log
# verbose = true
# Ignore software-injected mouse moves for edge switching (default: false)
# ignore_injected = true

# Install signed updates from GitHub Releases automatically
# auto_update = true
